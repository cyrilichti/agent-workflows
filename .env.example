# Copy to .env and fill every empty secret before starting Docker Compose.
# Use distinct random hex strings (32 bytes / 64 hex characters) for secrets.
# Never commit .env. Compose reads it; no startup script modifies it.

# Select exactly one profile: codex or openai-api.
COMPOSE_PROFILES=codex
AI_MODEL=gpt-6-luna
INFERENCE_ENABLED=false
# Required for openai-api when enabling inference. Billing is separate from ChatGPT.
OPENAI_API_KEY=
# Optional: restrict Codex login to a specific ChatGPT workspace ID.
CODEX_WORKSPACE_ID=

# Local UI accounts. Kestra reads these credentials from configuration.
KESTRA_ADMIN_EMAIL=local@example.test
KESTRA_ADMIN_PASSWORD=
LANGFUSE_ADMIN_PASSWORD=

# Infrastructure passwords and application secrets (distinct random hex strings).
KESTRA_DB_PASSWORD=
POSTGRES_PASSWORD=
NEXTAUTH_SECRET=
LANGFUSE_SALT=
# Exactly 64 hexadecimal characters (32 bytes).
LANGFUSE_ENCRYPTION_KEY=
CLICKHOUSE_PASSWORD=
MINIO_PASSWORD=
REDIS_PASSWORD=
# Local Langfuse project credentials, chosen by you (not OpenAI API keys).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
