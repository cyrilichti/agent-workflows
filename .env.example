# Copy to .env and fill every empty secret before starting Docker Compose.
# Generate a different value for each infrastructure password, NEXTAUTH_SECRET,
# LANGFUSE_SALT, LANGFUSE_ENCRYPTION_KEY, LANGFUSE_PUBLIC_KEY and
# LANGFUSE_SECRET_KEY:
# openssl rand -hex 32
# SECRET_BRIDGE_TOKEN uses the base64 variant documented below.
# OPENAI_API_KEY is issued by OpenAI; CODEX_WORKSPACE_ID is an existing workspace ID.
# Never commit .env. Compose reads it; no startup script modifies it.

# The bridge runs on the host, under your normal Codex user account.
AI_PROVIDER=codex
# Leave empty to inherit the Codex model. Required for openai-api.
AI_MODEL=gpt-6.1-sol
INFERENCE_ENABLED=false
OPENAI_API_KEY=
CODEX_WORKSPACE_ID=
# CLI executable on the host PATH, or an absolute executable path.
CODEX_BIN=codex
# Optional working directory for Codex; empty uses your home directory (~).
CODEX_WORKING_DIRECTORY=
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8787
# URL reachable from the Kestra container.
BRIDGE_URL=http://host.docker.internal:8787
# Base64-encoded random bearer token, shared with Kestra secret('BRIDGE_TOKEN').
# Generate the value with:
# openssl rand -hex 32 | tr -d '\n' | openssl base64 -A
SECRET_BRIDGE_TOKEN=
REQUEST_TIMEOUT_MS=1800000
LANGFUSE_URL=http://localhost:3001
LANGFUSE_PUBLIC_URL=http://localhost:3001
LANGFUSE_PROJECT_ID=local-ai

# Local UI accounts. Kestra reads these credentials from configuration.
# Kestra requires at least 8 characters, including one uppercase letter, one
# lowercase letter and one digit. Generate a compatible password with:
# printf 'Aa1-%s\n' "$(openssl rand -hex 30)"
KESTRA_ADMIN_EMAIL=local@example.test
KESTRA_ADMIN_PASSWORD=
LANGFUSE_ADMIN_EMAIL=local@example.test
LANGFUSE_ADMIN_PASSWORD=

# Infrastructure passwords and application secrets (distinct random hex strings).
KESTRA_DB_PASSWORD=
POSTGRES_PASSWORD=
NEXTAUTH_SECRET=
LANGFUSE_SALT=
# Exactly 64 hexadecimal characters (32 bytes).
LANGFUSE_ENCRYPTION_KEY=
CLICKHOUSE_PASSWORD=
MINIO_PASSWORD=
REDIS_PASSWORD=
# Local Langfuse project credentials, chosen by you (not OpenAI API keys).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
